{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shechterlab/ptmcontext/schemas/site.schema.json",
  "title": "Site config",
  "description": "One site (a release and, later, its website): which mark, which sequences and annotations, which marked residues, which analyses, what to check against, where to write. Changing site is changing this file.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "mark",
    "snapshot",
    "marks",
    "analyses",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "published",
        "working",
        "offline_pilot"
      ],
      "description": "offline_pilot: outputs stay out of the repository"
    },
    "mark": {
      "type": "string",
      "description": "a packaged profile id, or a path to a profile file"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "input",
        "release"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "first_of": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                },
                "description": "each protein's units from the first input that has any for it"
              },
              "all_of": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                },
                "description": "every input's units"
              }
            }
          }
        ]
      },
      "description": "role -> manifest name, or several names combined (first_of, all_of): the inputs the layers read, by the role they fill (disorder, domains, ...)"
    },
    "trusted_plugins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "packages whose layers this site may load"
    },
    "marks": {
      "type": "object",
      "required": [
        "input",
        "accession",
        "position"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string",
          "description": "manifest name of the table of marked residues"
        },
        "accession": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "description": "rows kept: every condition holds"
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "description": "rows dropped: their residues count as other residues, like any unmarked candidate"
        },
        "residue_mismatch": {
          "enum": [
            "error",
            "drop"
          ],
          "description": "a mark that is not on one of the profile's residues of the snapshot"
        },
        "attributes": {
          "type": "object",
          "description": "columns of the marks table the website keeps for each mark: to colour sites, filter them and show where they come from. Never used by a test.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "column",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "its name on the page"
              },
              "kind": {
                "enum": [
                  "category",
                  "list",
                  "number"
                ],
                "description": "category: one value; list: several, split by separator; number"
              },
              "separator": {
                "type": "string",
                "description": "list: between values (default \"; \")"
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "value -> its label on the page, in the order shown"
              },
              "link": {
                "type": "object",
                "required": [
                  "column",
                  "url"
                ],
                "additionalProperties": false,
                "description": "list: a column holding each value's identifier (in the same order) and the URL it opens ({} is the identifier)",
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              },
              "colour": {
                "type": "boolean",
                "description": "offered in \"Colour sites by\""
              },
              "filter": {
                "type": "boolean",
                "description": "offered as a filter"
              },
              "help": {
                "type": "string"
              },
              "colours": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "description": "value -> its colour when sites are coloured by this attribute (default: a fixed palette in the order of values)"
              },
              "records": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "list: value -> a URL for that source's own record of the protein ({acc}), used instead of the paper link"
              },
              "provenance": {
                "type": "boolean",
                "description": "the attribute says how a mark was found (its studies, how it was localised, notes), not what it is: comparisons of marks show it as a caveat, and the first linked list of these gives the study strata"
              }
            }
          }
        },
        "left_out": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "description": "rows kept pending: counted on neither side of a residue test (neither as marks nor as other residues), unlike exclude, which drops the row and leaves its residue among the others"
        }
      }
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "the analysis column of the statistics rows"
          },
          "layer": {
            "type": "string"
          },
          "test": {
            "enum": [
              "residue",
              "protein_sets"
            ],
            "default": "residue"
          },
          "methods": {
            "type": "array",
            "items": {
              "enum": [
                "fisher",
                "mantel_haenszel"
              ]
            }
          },
          "title": {
            "type": "string",
            "description": "card heading (default: the layer's title)"
          },
          "question": {
            "type": "string",
            "description": "the question the card answers, in words"
          },
          "section": {
            "type": "string",
            "description": "the Overview section it is listed under (default: the layer's)"
          },
          "sets": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "input",
                  "set",
                  "protein"
                ],
                "additionalProperties": false,
                "description": "protein_sets: the table of (set, protein) pairs; input is a role of the site's inputs",
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "set": {
                    "type": "string"
                  },
                  "protein": {
                    "type": "string"
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/condition"
                    }
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/condition"
                    }
                  },
                  "where": {
                    "type": "array",
                    "minItems": 1,
                    "description": "protein_sets: rows kept by what another table says of one of their columns (the organism of a protein, the kind of a set): a row is kept when its column's value is the key of a row of that table that include and exclude keep; every condition must hold. On the protein column, accessions are compared as entries (an isoform counts as its entry)",
                    "items": {
                      "type": "object",
                      "required": [
                        "column",
                        "input",
                        "key"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "column": {
                          "type": "string",
                          "description": "the column of this table"
                        },
                        "input": {
                          "type": "string",
                          "description": "a role of the site's inputs: the other table"
                        },
                        "key": {
                          "type": "string",
                          "description": "the other table's column holding the same values"
                        },
                        "include": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/condition"
                          },
                          "description": "the other table's rows that count: every condition holds"
                        },
                        "exclude": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/condition"
                          },
                          "description": "the other table's rows that do not count"
                        }
                      }
                    }
                  },
                  "history": {
                    "type": "object",
                    "required": [
                      "input",
                      "from",
                      "to"
                    ],
                    "additionalProperties": false,
                    "description": "protein_sets: members named by an older (secondary) UniProt accession, brought to the snapshot's current entry through an accession history: a member that is an entry stays, one the history maps to exactly one entry becomes it, any other is dropped. Not for sets of other identifiers",
                    "properties": {
                      "input": {
                        "type": "string",
                        "description": "a role of the site's inputs: the history table"
                      },
                      "from": {
                        "type": "string",
                        "description": "the column of old accessions"
                      },
                      "to": {
                        "type": "string",
                        "description": "the column of the entry each now belongs to"
                      },
                      "include": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/condition"
                        },
                        "description": "the history's rows read (its secondary accessions, say)"
                      },
                      "exclude": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/condition"
                        }
                      }
                    }
                  },
                  "families": {
                    "type": "object",
                    "required": [
                      "rules"
                    ],
                    "additionalProperties": false,
                    "description": "protein_sets: gather the table's sets into families by their names, with a site's own rules file (schemas/set_families.schema.json); each family holds the members of its sets, and the source still annotates every member of its table (the background, unless whole_universe)",
                    "properties": {
                      "rules": {
                        "type": "string",
                        "description": "the rules file, relative to the site's repository (sites/data/...)"
                      },
                      "by": {
                        "type": "string",
                        "description": "the column whose names the rules read (default: the set column)"
                      },
                      "lists": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "description": "the rules file's lists whose families this analysis tests (default: every list)"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "input",
                  "protein",
                  "classes",
                  "ontology",
                  "level"
                ],
                "additionalProperties": false,
                "description": "protein_sets: sets from a class hierarchy (PANTHER protein classes, a GO slim): each protein's classes, and the ontology that places them",
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "role of the table giving each protein its classes"
                  },
                  "protein": {
                    "type": "string"
                  },
                  "classes": {
                    "type": "string",
                    "description": "the column of class ids"
                  },
                  "separator": {
                    "type": "string",
                    "description": "between a protein's class ids (default ;)"
                  },
                  "ontology": {
                    "type": "object",
                    "required": [
                      "input",
                      "id",
                      "name",
                      "parent",
                      "root"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "parent": {
                        "type": "string"
                      },
                      "root": {
                        "type": "string",
                        "description": "the root's id: its children are the top level"
                      }
                    }
                  },
                  "level": {
                    "enum": [
                      "top",
                      "below_top"
                    ],
                    "description": "top: each protein's top-level classes; below_top: every class under the top level a protein's classes lie in or under"
                  },
                  "groups": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "description": "level top only: group name -> its top-level class ids; every top-level class in exactly one group"
                  },
                  "unclassified": {
                    "type": "string",
                    "description": "a set of the universe's proteins with no class at this level, under this name"
                  }
                }
              }
            ]
          },
          "identifiers": {
            "type": "object",
            "required": [
              "map"
            ],
            "additionalProperties": false,
            "description": "protein_sets: the sets hold another identifier (Entrez genes, say): each of the site's proteins is mapped to it through these tables in turn, and the test counts identifiers, its universe the proteins' identifiers",
            "properties": {
              "noun": {
                "type": "string",
                "description": "one identifier, in words (gene)"
              },
              "nouns": {
                "type": "string",
                "description": "several, in words (genes)"
              },
              "map": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "input",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "input": {
                      "type": "string",
                      "description": "a role of the site's inputs"
                    },
                    "from": {
                      "type": "string",
                      "description": "the column holding the step before's identifier (the protein's accession, first)"
                    },
                    "to": {
                      "type": "string",
                      "description": "the column holding the next identifier"
                    },
                    "separator": {
                      "type": "string",
                      "description": "the to column holds lists, split here"
                    },
                    "take": {
                      "enum": [
                        "first",
                        "all"
                      ],
                      "default": "all",
                      "description": "of a list, the first item or every item"
                    }
                  }
                }
              }
            }
          },
          "names": {
            "type": "object",
            "required": [
              "input",
              "set",
              "name"
            ],
            "additionalProperties": false,
            "description": "protein_sets: the sets' names; a filter here restricts the sets tested",
            "properties": {
              "input": {
                "type": "string"
              },
              "set": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "include": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              }
            }
          },
          "universe": {
            "enum": [
              "annotated",
              "snapshot"
            ],
            "description": "annotated: the proteins in at least one set; snapshot: every entry of the sequences"
          },
          "whole_universe": {
            "type": "boolean",
            "description": "the background is the whole universe, not only its proteins in some set"
          },
          "min_size": {
            "type": "integer",
            "minimum": 1
          },
          "max_size": {
            "type": "integer",
            "minimum": 1
          },
          "order": {
            "type": "array",
            "minItems": 1,
            "description": "protein_sets: the order its rows are written in, the first key first (default: ascending p, then the set's name, which also breaks every tie here)",
            "items": {
              "type": "object",
              "required": [
                "by"
              ],
              "additionalProperties": false,
              "properties": {
                "by": {
                  "enum": [
                    "a",
                    "b",
                    "c",
                    "d",
                    "fold_enrichment",
                    "p",
                    "q",
                    "category"
                  ],
                  "description": "a column of the statistics rows"
                },
                "descending": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "background": {
            "type": "string",
            "description": "the statistics rows' background, in words"
          },
          "sub": {
            "type": "string",
            "description": "the line under the figure's title"
          },
          "abundance": {
            "type": "object",
            "required": [
              "input",
              "protein",
              "value"
            ],
            "additionalProperties": false,
            "description": "protein_sets: repeat each set's test within strata of a covariate (Mantel-Haenszel across its deciles)",
            "properties": {
              "input": {
                "type": "string"
              },
              "protein": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "strata": {
                "type": "integer",
                "minimum": 2
              },
              "label": {
                "type": "string",
                "description": "added to the background of the stratified rows"
              },
              "combine": {
                "enum": [
                  "max"
                ],
                "default": "max",
                "description": "with identifiers: an identifier takes the highest value of the proteins that map to it"
              }
            }
          },
          "scores": {
            "type": "object",
            "required": [
              "input",
              "set",
              "protein",
              "value"
            ],
            "additionalProperties": false,
            "description": "protein_sets, for the website only: a score for each membership of a protein in a set (CD-CODE's confidence that a protein belongs to a condensate), offered as a filter of the members at or above a level; no test reads it. Members as entries and, with sets.history, brought to the snapshot's entries; a protein in a set on several rows takes its highest score",
            "properties": {
              "input": {
                "type": "string",
                "description": "a role of the site's inputs: (set, protein, score) rows"
              },
              "set": {
                "type": "string"
              },
              "protein": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "description": "the column of scores"
              },
              "include": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "label": {
                "type": "string",
                "description": "the filter's name"
              },
              "help": {
                "type": "string"
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1,
                "description": "the thresholds offered (a member's score at least this)"
              },
              "max": {
                "type": "number",
                "description": "the highest score: the options read \"at least 3 of 5\""
              }
            }
          },
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "description": "protein_sets: the words of its control in the Filters panel",
            "properties": {
              "label": {
                "type": "string",
                "description": "the control's name (default: its title, and whose proteins it counts)"
              },
              "any": {
                "type": "string",
                "description": "offer marks on a protein in any of the source's sets, with these words (In any CD-CODE condensate)"
              },
              "sets": {
                "enum": [
                  "tested",
                  "all"
                ],
                "default": "tested",
                "description": "the sets the control lists: those tested, or every set of the source holding a marked protein (all)"
              }
            }
          },
          "new": {
            "type": "boolean",
            "description": "not in the site's reference: no parity check, and the website marks it new"
          },
          "with": {
            "type": "object",
            "description": "the parameters of a layer made from them (ptmc layers lists them): regions {role, kind, window, noun, nouns, labels, help, title, question, sub, section, track}; residue_values {role, bins, classes, missing, noun, labels, help, title, question, sub, section, track}"
          }
        },
        "anyOf": [
          {
            "required": [
              "layer"
            ]
          },
          {
            "required": [
              "test",
              "sets"
            ],
            "properties": {
              "test": {
                "const": "protein_sets"
              }
            }
          }
        ]
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "a published output the rebuild must equal",
      "properties": {
        "statistics": {
          "type": "string",
          "description": "manifest name of a statistics table"
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "folder"
      ],
      "additionalProperties": false,
      "properties": {
        "folder": {
          "type": "string"
        }
      }
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "description": "the website's look and words: everything that differs between sites. Layout and behaviour are the kit's.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string",
          "description": "one line under the title"
        },
        "url": {
          "type": "string"
        },
        "band": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "the header band's gradient, top-left to bottom-right"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent_dark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "the accent on the dark theme"
        },
        "brand_ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "brand_ink_dark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "description": "an SVG file, relative to the repository"
        },
        "art": {
          "type": "string",
          "description": "the header picture: an SVG file, relative to the repository (default: a drawn protein with its marks)"
        },
        "art_label": {
          "type": "string"
        },
        "lab": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "affiliation": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "example searches shown under the search bar"
        },
        "version": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "description": "type: CSS font stacks, and the stylesheet that serves them (default: IBM Plex Serif headings, Inter body, IBM Plex Mono)",
          "properties": {
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "mono": {
              "type": "string"
            },
            "stylesheet": {
              "type": "string"
            }
          }
        },
        "partners": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "species"
          ],
          "description": "interaction partners on protein pages, live from STRING; leave out for no partners card",
          "properties": {
            "species": {
              "type": "integer",
              "description": "the NCBI taxon STRING files this organism under (9606 human, 4932 budding yeast, 10090 mouse)"
            },
            "network": {
              "enum": [
                "physical",
                "functional"
              ],
              "description": "the network shown first (default physical)"
            },
            "min_score": {
              "enum": [
                0.4,
                0.7,
                0.9
              ],
              "description": "the STRING score shown first (default 0.7, high confidence)"
            }
          }
        },
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "description": "the Overview page: which questions open as cards, in which sections and order (default: every question, in the analyses' order, under its section)",
          "properties": {
            "question": {
              "type": "string",
              "description": "the page's heading"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "rows a tile shows before \"+N more\" (default 7, as the original explorer)"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "cards"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "cards": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "description": "an analysis id"
                        },
                        {
                          "type": "object",
                          "required": [
                            "analysis"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "analysis": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            },
                            "rows": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "summary": {
                              "type": "string",
                              "description": "the line under the card; {top} is the strongest class, {fold} its effect"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "filters": {
          "type": "array",
          "description": "the Filters panel: groups, in order; each lists the questions' classes and the marks' attributes it offers (default: one group per section, then one per filterable attribute)",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "analyses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "stats": {
          "type": "array",
          "description": "the tiles under the header (default: marks, proteins, questions, tests)",
          "items": {
            "oneOf": [
              {
                "enum": [
                  "marks",
                  "proteins",
                  "questions",
                  "tests"
                ]
              },
              {
                "type": "object",
                "required": [
                  "attribute",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "attribute": {
                    "type": "string",
                    "description": "a list attribute of the marks: its distinct values are counted"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "sites": {
          "type": "object",
          "additionalProperties": false,
          "description": "the Sites tab",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "residue questions shown as columns (default: the first with classes); questions with flags (motifs) show as tags beside the window"
            }
          }
        },
        "protein": {
          "type": "object",
          "additionalProperties": false,
          "description": "the protein page",
          "properties": {
            "facts": {
              "type": "array",
              "description": "tiles counting the protein's marks in some classes of a question",
              "items": {
                "type": "object",
                "required": [
                  "analysis",
                  "classes"
                ],
                "additionalProperties": false,
                "properties": {
                  "analysis": {
                    "type": "string"
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "links": {
              "type": "array",
              "description": "more links on every protein page, by UniProt accession ({acc})",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "\\{acc\\}"
                  }
                }
              }
            },
            "default_links": {
              "type": "boolean",
              "description": "false: leave out the kit's own list (config/protein_links.json)"
            }
          }
        },
        "compare": {
          "type": "object",
          "additionalProperties": false,
          "description": "comparing marks with marks (the Overview's 'compared with other marks')",
          "properties": {
            "stratify": {
              "type": "string",
              "description": "the list attribute whose sources define the within-study strata (default: the first provenance list attribute with a link)"
            }
          }
        }
      }
    },
    "manifest": {
      "type": "string",
      "description": "the input manifest, relative to the repository (default inputs.json)"
    },
    "citation": {
      "type": "string",
      "description": "the site's CITATION.cff, relative to the repository: the citation, data sources, version and date every page and export carries"
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "string"
        },
        "equals": {
          "type": "string"
        },
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contains": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "contains"
          ]
        }
      ]
    }
  }
}
